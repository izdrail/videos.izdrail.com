# Image Generation (SD-Turbo)
IMAGE_GENERATION_ENABLED=true
IMAGE_GENERATION_MODEL=stabilityai/sd-turbo
IMAGE_GENERATION_DEVICE=auto
IMAGE_GENERATION_STEPS=1
IMAGE_GENERATION_GUIDANCE_SCALE=0.0
IMAGE_GENERATION_WIDTH=512
IMAGE_GENERATION_HEIGHT=512
IMAGE_GENERATION_CACHE_DIR=cache/images

# Visual Source Settings
VISUAL_SOURCE=stock  # stock, ai, mixed
MIXED_MODE_IMAGE_RATIO=0.5

# Media API Keys
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=
UNSPLASH_SECRET_KEY=
